name = "vinny-workout-api"
main = "worker.js"
compatibility_date = "2026-09-07"

[vars]
ALLOWED_ORIGIN = "https://vinnyvuitton.github.io"
ALLOW_LOCAL_DEV = "false"
OPENAI_MODEL = "gpt-6.1-sol"
OPENAI_ENABLED = "true"
VAPID_PUBLIC_KEY = "REPLACE_WITH_PUBLIC_VAPID_KEY"
VAPID_SUBJECT = "https://vinnyvuitton.github.io/tracker/"

[triggers]
# Ten-minute candidates allow personal reminder times. The Worker applies Chicago
# time, quiet hours, category toggles, pacing, and duplicate suppression.
crons = ["*/10 * * * *"]

[ai]
binding = "AI"
remote = true

[[queues.producers]]
binding = "ALERT_QUEUE"
queue = "REPLACE_WITH_ALERT_QUEUE"

[[queues.consumers]]
queue = "REPLACE_WITH_ALERT_QUEUE"
max_batch_size = 1
max_batch_timeout = 1
max_retries = 3

[[kv_namespaces]]
binding = "TRACKER_KV"
id = "REPLACE_WITH_EXISTING_KV_NAMESPACE_ID"

# TRACKER_TOKEN and VAPID_PRIVATE_JWK are encrypted Worker secrets.

# Enable only after configuring server secrets and reviewing API costs.
# OPENAI_API_KEY and COACH_REVIEW_TOKEN must be encrypted Worker secrets.
[[durable_objects.bindings]]
name = "SHOPPING_ROOM"
class_name = "ShoppingRoom"

[[migrations]]
tag = "shopping-v1"
new_sqlite_classes = ["ShoppingRoom"]
