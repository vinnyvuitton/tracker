name = "vinny-workout-api"
main = "worker.js"
compatibility_date = "2026-09-07"

[vars]
ALLOWED_ORIGIN = "https://vinnyvuitton.github.io"
ALLOW_LOCAL_DEV = "false"
VAPID_PUBLIC_KEY = "REPLACE_WITH_PUBLIC_VAPID_KEY"
VAPID_SUBJECT = "https://YOUR_GITHUB_USERNAME.github.io/YOUR_REPOSITORY/"

[triggers]
# Ten-minute candidates allow personal reminder times. The Worker applies Chicago
# time, quiet hours, category toggles, pacing, and duplicate suppression.
crons = ["*/10 * * * *"]

[ai]
binding = "AI"
remote = true

[[queues.producers]]
binding = "ALERT_QUEUE"
queue = "REPLACE_WITH_ALERT_QUEUE"

[[queues.consumers]]
queue = "REPLACE_WITH_ALERT_QUEUE"
max_batch_size = 1
max_batch_timeout = 1
max_retries = 3

[[kv_namespaces]]
binding = "TRACKER_KV"
id = "REPLACE_WITH_EXISTING_KV_NAMESPACE_ID"

# Set TRACKER_TOKEN and VAPID_PRIVATE_JWK as encrypted Worker secrets.
# Never put secret values in this file or in GitHub.
